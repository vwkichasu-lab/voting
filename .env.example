# Environment Configuration Template

# Application
APP_NAME="Level 200 Election"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=voting_system
DB_USERNAME=root
DB_PASSWORD=

# Session & Security
SESSION_DRIVER=database
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Mail (for OTP delivery)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=election@level200.local
MAIL_FROM_NAME="Level 200 Election"

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# Voting Configuration
VOTING_ENABLE_MANUAL_PAUSE=true
VOTING_ENABLE_RUNOFF=false

# Frontend
REACT_APP_API_BASE_URL=http://localhost:8000/api
REACT_APP_ENVIRONMENT=development

# Audit & Logging
LOG_CHANNEL=daily
AUDIT_LOG_ENABLED=true

# Security
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_HTTP_ONLY=true
CSRF_COOKIE_SAME_SITE=Lax
