# Environment Configuration Template

# Application
APP_NAME="Level 200 Election"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# MongoDB Configuration
# Get connection string from: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/database-name
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/voting-system

# Node Environment
NODE_ENV=production

# API Port (for local development, ignored on Vercel/Netlify)
PORT=8000

# Session & Security
SESSION_DRIVER=database
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Mail (for OTP delivery)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=election@level200.local
MAIL_FROM_NAME="Level 200 Election"

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# Voting Configuration
VOTING_ENABLE_MANUAL_PAUSE=true
VOTING_ENABLE_RUNOFF=false

# Frontend
REACT_APP_API_BASE_URL=http://localhost:8000/api
REACT_APP_ENVIRONMENT=development

# Audit & Logging
LOG_CHANNEL=daily
AUDIT_LOG_ENABLED=true

# Security
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_HTTP_ONLY=true
CSRF_COOKIE_SAME_SITE=Lax
